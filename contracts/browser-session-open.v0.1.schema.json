{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.local/contracts/browser-session-open.v0.1.schema.json",
  "title": "AIOS Interactive Browser Session Open v0.1",
  "type": "object",
  "required": ["url"],
  "properties": {
    "url": {"type": "string", "format": "uri", "minLength": 1},
    "resource_origins": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "session_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "visible_text_chars": {"type": "integer", "minimum": 1, "maximum": 12000},
    "max_elements": {"type": "integer", "minimum": 1, "maximum": 60}
  },
  "unevaluatedProperties": false
}
