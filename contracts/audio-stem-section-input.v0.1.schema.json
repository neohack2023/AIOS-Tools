{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.local/contracts/audio-stem-section-input.v0.1.schema.json",
  "title": "AIOS Audio Stem and Section Input v0.1",
  "type": "object",
  "required": [
    "source_audio_path",
    "source_sha256",
    "slice1_run_id",
    "slice1_receipt_path",
    "slice1_source_sha256",
    "profile_id",
    "profile_path",
    "profile_checksum",
    "model_cache_directory",
    "output_directory",
    "scope_key",
    "requested_by",
    "authority_transfer"
  ],
  "properties": {
    "source_audio_path": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slice1_run_id": {"type": "string", "pattern": "^S1-[A-Za-z0-9._-]+$"},
    "slice1_receipt_path": {"type": "string", "minLength": 1},
    "slice1_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_id": {"const": "slice2-stem-section-v0.1"},
    "profile_path": {"type": "string", "minLength": 1},
    "profile_checksum": {
      "const": "26ac1b86891a8dd7775a3b25bdb7f4b00d9ab284c7575815ce43c5f14e19680f"
    },
    "model_cache_directory": {"type": "string", "minLength": 1},
    "output_directory": {"type": "string", "minLength": 1},
    "scope_key": {"type": "string", "minLength": 1},
    "requested_by": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["HUMAN", "CI", "SERVICE", "LLM"]},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400, "default": 3600},
    "authority_transfer": {"const": false}
  },
  "additionalProperties": false
}
