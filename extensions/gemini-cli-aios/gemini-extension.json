{
  "name": "aios-tools",
  "version": "0.2.0",
  "description": "Governed Gemini CLI client for the AIOS-Tools MCP server.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "aios-tools": {
      "command": "aios-tools-mcp",
      "args": ["--transport", "stdio"],
      "timeout": 30000,
      "includeTools": [
        "system_health",
        "canonical_hash_json",
        "validate_json_schema"
      ]
    }
  }
}
