{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.local/contracts/tool-result.v0.1.schema.json",
  "title": "AIOS Tool Execution Receipt v0.1",
  "type": "object",
  "required": ["receipt_id", "request_id", "tool", "tool_version", "scope", "mode", "status", "started_at", "completed_at", "output", "errors", "provenance", "external_effects", "authority_transfer"],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "tool_version": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "mode": {"const": "READ_ONLY"},
    "status": {"enum": ["COMPLETED", "FAILED", "BLOCKED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "output": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "array", "items": {"type": "object"}},
    "external_effects": {"type": "array", "maxItems": 0},
    "authority_transfer": {"const": false}
  },
  "unevaluatedProperties": false
}
