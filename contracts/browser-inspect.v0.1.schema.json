{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.local/contracts/browser-inspect.v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["url"],
  "properties": {
    "url": {"type": "string", "minLength": 1, "maxLength": 4096},
    "visible_text_chars": {"type": "integer", "minimum": 1, "maximum": 50000},
    "elapsed_seconds": {"type": "integer", "minimum": 1, "maximum": 60}
  }
}
